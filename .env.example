# LaunchQueue Client Environment Variables
VITE_API_URL=http://localhost:5000/api
# Optional fallback only. Prefer GOOGLE_CLIENT_ID on the backend via /api/auth/config.
VITE_GOOGLE_CLIENT_ID=

# Share of page loads reporting LCP/INP/CLS: 0 disables, 0.1 samples 10%.
VITE_PERFORMANCE_SAMPLE_RATE=0.1
